        "format": "plain_text",
        "source": "nuke.Knob.tooltip()",
        "text": "Only the section of any main samples from the B input within the range of any holdout samples from the A inputs will be held out."
      },
      "id": "arg:volumetric_holdout",
      "knob_type": "Boolean_Knob",
      "label": "volumetric holdout",
      "name": "volumetric_holdout",
      "python_type": "bool",
      "python_type_source": "generator_type_map_v1",
      "raw_script": "false",
      "shape": {
        "array_size": 1,
        "dimensions": 1,
