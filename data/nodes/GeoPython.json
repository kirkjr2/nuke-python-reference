      "python_type": "str",
      "python_type_source": "generator_type_map_v1",
      "raw_script": "from pxr import Usd, Sdf\n\nstage = geo_python.stage()\n\nheight = 5\nheight_knob = geo_python.knob('height')\nif height_knob:\n  height = height_knob.getValue()\n\nradius = 1\nradius_knob = geo_python.knob('radius')\nif radius_knob:\n  radius = radius_knob.getValue()\n\npath = f\"/{geo_python.name()}\"\npath_knob = geo_python.knob('path')\nif path_knob:\n  user_path = path_knob.getValue()\n  if user_path:\n    path = user_path\n\n# Example code: Make a Cone\nfrom pxr import UsdGeom\ncone = UsdGeom.Cone.Define(stage, path)\ncone.CreateHeightAttr().Set(height)\ncone.CreateRadiusAttr().Set(radius)\ngeo_python.setModifiedPaths([path])\ngeo_python.setCreatedPaths([path])  # If this node creates the geometry\n",
