      },
      "description": {
        "format": "plain_text",
        "source": "nuke.Knob.tooltip()",
        "text": "If the shutteroffset parameter is set to 'custom', this parameter is used to set the time that the shutter opens by adding it to the current frame.<p>Values are in frames, so -0.5 would open the shutter half a frame before the current frame.</div>"
      },
      "id": "arg:shuttercustomoffset",
      "knob_type": "Array_Knob",
      "label": " ",
      "name": "shuttercustomoffset",
      "python_type": "float",
